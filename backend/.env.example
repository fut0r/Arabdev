# ---- ArabDev backend configuration --------------------------------------------
# Copy to backend/.env and adjust. Every value can also be set as an environment variable.

ENVIRONMENT=development            # development | production | test

# SQLite database file. Defaults to backend/arabdev.db; use an absolute path elsewhere
# (four slashes on Linux: sqlite:////var/lib/arabdev/arabdev.db).
# DATABASE_URL=sqlite:///./arabdev.db

# Optional. Enables shared rate limiting and caching across workers.
# REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Set COOKIE_SECURE=true when serving over HTTPS.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
# Production (arabdev.site):
#   ENVIRONMENT=production
#   COOKIE_SECURE=true
#   CORS_ORIGINS=https://arabdev.site
#   FRONTEND_URL=https://arabdev.site
#   MEDIA_URL=https://<api host>/media   (only when the API is not on arabdev.site itself)

# Contact addresses used in emails and the API docs.
# SUPPORT_EMAIL=support@arabdev.site
# HELLO_EMAIL=hi@arabdev.site
# MAIL_FROM=ArabDev <noreply@arabdev.site>

MEDIA_ROOT=./media
MAX_UPLOAD_BYTES=5242880
RATE_LIMIT_ENABLED=true

# ---- Outgoing mail -------------------------------------------------------------
# Without SMTP_HOST, messages are written to the log instead of being sent, and the
# six-digit codes are switched off in production so nobody is locked out.
# SMTP_HOST=smtp.arabdev.site
# SMTP_PORT=587
# SMTP_USERNAME=noreply@arabdev.site
# SMTP_PASSWORD=CHANGE_ME
# SMTP_STARTTLS=true            # use SMTP_SSL=true instead for port 465
# MAIL_FROM=ArabDev <noreply@arabdev.site>

# Emailed six-digit codes for signing in, signing up and account changes.
# EMAIL_CODES_ENABLED=true      # leave unset to follow the mail setup
# VERIFICATION_CODE_TTL_MINUTES=10
# VERIFICATION_MAX_ATTEMPTS=5
# VERIFICATION_RESEND_SECONDS=60

# ---- Cloudflare Turnstile ------------------------------------------------------
# Both keys must be set for the bot checks to run. The site key is public; the secret
# key never leaves the server. Create a widget at dash.cloudflare.com → Turnstile.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Cloudflare's testing keys, which always pass and work on localhost:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# TURNSTILE_HOSTNAMES=arabdev.site,www.arabdev.site   # optional allow-list

# ---- Proxies -------------------------------------------------------------------
# How many proxies in front of the API append to X-Forwarded-For (1 fits Vercel and the
# Docker nginx; add one for each extra proxy, such as Cloudflare's orange-cloud proxy).
# TRUSTED_PROXY_HOPS=1

# ---- Passwords -------------------------------------------------------------------
# Refuse new passwords found in public breaches. Only five characters of the password's
# SHA-1 hash are sent to Have I Been Pwned.
# PWNED_PASSWORDS_ENABLED=true

# ---- Moderation ------------------------------------------------------------------
# Moderators by username (comma-separated), besides accounts made admin with
# `python -m app.cli make-admin <username>`.
# ADMIN_USERNAMES=
# Where new reports are emailed. Defaults to SUPPORT_EMAIL.
# MODERATION_EMAIL=
# REPORT_AUTO_HIDE_THRESHOLD=3   # different reporters before a post is hidden for review
# REPORT_RETENTION_DAYS=365      # how long decided reports are kept

# ---- Hosting ---------------------------------------------------------------------
# STORAGE_BACKEND=local          # "database" keeps images in the database (no disk needed)
# CRON_SECRET=                   # bearer token for /api/v1/internal/cron/purge-tokens
# Where the API reads the built app shell for server-rendered public pages. Unset, it uses
# backend/spa_shell.html or frontend/dist/app.html, then FRONTEND_URL/app.html.
# SPA_SHELL_URL=
# SPA_SHELL_PATH=

# Optional 1.4 services (disabled until configured)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
WEEKLY_DIGEST_ENABLED=false
# STORAGE_BACKEND=s3 requires pip install -e ".[s3]"
S3_BUCKET=
S3_PUBLIC_URL=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Eligible reports only; all reports remain visible to moderators.
REPORT_TRUSTED_AGE_DAYS=7
